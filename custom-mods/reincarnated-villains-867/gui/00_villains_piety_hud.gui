# Non-destructive partial GUI type overrides for custom ideological piety level icons
# (CK3 1.20 engine does not reload Clausewitz NGraphics::NGameIcons::PIETY_GROUPS from mods)

types VillainsPietyIcons
{
	type villains_player_piety_level_icon = widget {
		size = { 30 30 }

		icon = {
			name = "vanilla_piety_icon"
			visible = "[And( GetPlayer.IsValid, GetScriptedGui('villains_piety_group_vanilla_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			size = { 100% 100% }
			texture = "[GetPlayer.GetPietyLevelTexture]"
		}

		widget = {
			name = "custom_piety_communist"
			visible = "[And( GetPlayer.IsValid, GetScriptedGui('villains_piety_group_communist_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			size = { 100% 100% }
			icon = {
				visible = "[LessThanOrEqualTo_int32( GetPlayer.GetPietyLevel, '(int32)0' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_00.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)1' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_01.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)2' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_02.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)3' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_03.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)4' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_04.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)5' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_05.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)6' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_06.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)7' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_07.dds"
			}
			icon = {
				visible = "[GreaterThanOrEqualTo_int32( GetPlayer.GetPietyLevel, '(int32)8' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_communist_08.dds"
			}
		}

		widget = {
			name = "custom_piety_fascist"
			visible = "[And( GetPlayer.IsValid, GetScriptedGui('villains_piety_group_fascist_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			size = { 100% 100% }
			icon = {
				visible = "[LessThanOrEqualTo_int32( GetPlayer.GetPietyLevel, '(int32)0' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_00.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)1' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_01.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)2' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_02.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)3' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_03.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)4' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_04.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)5' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_05.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)6' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_06.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)7' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_07.dds"
			}
			icon = {
				visible = "[GreaterThanOrEqualTo_int32( GetPlayer.GetPietyLevel, '(int32)8' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_fascist_08.dds"
			}
		}

		widget = {
			name = "custom_piety_capitalist"
			visible = "[And( GetPlayer.IsValid, GetScriptedGui('villains_piety_group_capitalist_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			size = { 100% 100% }
			icon = {
				visible = "[LessThanOrEqualTo_int32( GetPlayer.GetPietyLevel, '(int32)0' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_00.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)1' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_01.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)2' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_02.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)3' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_03.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)4' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_04.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)5' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_05.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)6' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_06.dds"
			}
			icon = {
				visible = "[EqualTo_int32( GetPlayer.GetPietyLevel, '(int32)7' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_07.dds"
			}
			icon = {
				visible = "[GreaterThanOrEqualTo_int32( GetPlayer.GetPietyLevel, '(int32)8' )]"
				size = { 100% 100% }
				texture = "gfx/interface/icons/modifiers/icon_piety_capitalist_08.dds"
			}
		}
	}

